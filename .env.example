# =============================================================================
#  Windows Media Stack — configuration template
#  Copy to `.env` and fill in. NEVER commit `.env` (it's gitignored).
#  Nothing in here is real; every value below is a placeholder.
# =============================================================================

# ---- Storage root (one NTFS volume so downloads + library can hardlink) ----
DATA_ROOT=C:\data
MIN_FREE_SPACE_GB=150

# ---- Service base URLs (localhost; change ports if they collide) ----
PROWLARR_URL=http://127.0.0.1:9696
SONARR_URL=http://127.0.0.1:8989
RADARR_URL=http://127.0.0.1:7878
BAZARR_URL=http://127.0.0.1:6767
SABNZBD_URL=http://127.0.0.1:8085
QBITTORRENT_URL=http://127.0.0.1:8081
SEERR_URL=http://127.0.0.1:5055
FLARESOLVERR_URL=http://127.0.0.1:8191
PLEX_URL=http://127.0.0.1:32400

# ---- API keys (find each in the app: Settings → General → API Key) ----
PROWLARR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SONARR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RADARR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SABNZBD_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SEERR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- qBittorrent Web UI (enable "Bypass auth for localhost" to skip these) ----
QBITTORRENT_USER=admin
QBITTORRENT_PASS=

# ---- VPN ----
# Name of the Windows network adapter the VPN creates (bind qBittorrent to it).
VPN_ADAPTER_NAME=YourVpnAdapter

# ---- Usenet provider (bring your own; entered in the SABnzbd UI, not here) ----
# USENET_HOST, PORT, SSL, CONNECTIONS, USERNAME, PASSWORD -> set in SABnzbd's web UI.

# ---- Indexers (bring your own; add in Prowlarr, never in a public file) ----
# Add Usenet (Newznab) and/or torrent indexers in Prowlarr's UI with their own keys.
# Do NOT list private-tracker names or keys here if this repo may ever go public.
