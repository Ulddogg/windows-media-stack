# ---- secrets: never commit ----
.env
.env.*
!.env.example
*.key
*.token
*.pem
secrets/
**/secrets.*

# API keys sometimes leak into these if copied from a live install — guard anyway
**/config.xml
**/sabnzbd.ini
**/settings.json

# ---- local state / runtime ----
*.log
logs/
tmp/
scratch/
*.db
*.db-shm
*.db-wal

# ---- OS / editor cruft ----
Thumbs.db
desktop.ini
.DS_Store
.vs/
.vscode/
*.user
